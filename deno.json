{
  "nodeModulesDir": "auto",
  "version": "0.0.0",
  "exclude": [
    "packages/store/vendor/"
  ],
  "workspace": [
    "packages/schema",
    "packages/provider",
    "packages/store",
    "packages/permission",
    "packages/tools",
    "packages/agent",
    "packages/server",
    "packages/cli",
    "packages/config",
    "packages/mcp",
    "packages/tuikit",
    "packages/tui"
  ],
  "imports": {
    "effect": "npm:effect@^4.0.0-beta.100",
    "effect/": "npm:/effect@^4.0.0-beta.100/",
    "hono": "npm:hono@^4.6.0",
    "zod": "npm:zod@^4.0.0",
    "kysely": "npm:kysely@^0.28.0",
    "@logtape/logtape": "npm:@logtape/logtape@^1.0.0",
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@^1.17.0",
    "@modelcontextprotocol/sdk/": "npm:/@modelcontextprotocol/sdk@^1.17.0/",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/fs": "jsr:@std/fs@^1.0.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.0",
    "@std/cli": "jsr:@std/cli@^1.0.0",
    "@std/json": "jsr:@std/json@^1.0.0",
    "@std/toml": "jsr:@std/toml@^1.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/testing/bdd": "jsr:@std/testing@^1.0.0/bdd",
    "@niuma/schema": "./packages/schema/mod.ts",
    "@niuma/provider": "./packages/provider/mod.ts",
    "@niuma/store": "./packages/store/mod.ts",
    "@niuma/store/vendor/": "./packages/store/vendor/",
    "@niuma/permission": "./packages/permission/mod.ts",
    "@niuma/tools": "./packages/tools/mod.ts",
    "@niuma/agent": "./packages/agent/mod.ts",
    "@niuma/server": "./packages/server/mod.ts",
    "@niuma/config": "./packages/config/mod.ts",
    "@niuma/mcp": "./packages/mcp/mod.ts",
    "@niuma/tuikit": "./packages/tuikit/mod.ts",
    "@niuma/tui": "./packages/tui/mod.ts"
  },
  "tasks": {
    "check": "deno check packages/*/mod.ts packages/cli/src/main.ts",
    "build:native": "cd packages/tuikit/native && cargo build --release",
    "cli": "deno run --allow-all --unstable-worker-options packages/cli/src/main.ts",
    "test": "deno test --allow-all --unstable-worker-options packages/"
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.window",
      "deno.unstable",
      "dom"
    ]
  }
}
